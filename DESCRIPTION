Package: CERMBscraper
Type: Package
Title: Scrape selected parts from fire-related documents
Version: 0.1.5
Date: 2024-08-08
Authors@R: c(
  person("Michael", "Bedward", role = c("aut", "cre"), email = "michael.bedward@gmail.com"),
  person("Owen", "Price", role = "aut")
  )
Description: Provides functions to extract selected content from fire-related
    documents such as Incident Action Plans (PDF format) produced by the NSW 
    Rural Fire Service. To use this package you need to have a Java runtime 
    environment installed on your computer.
Depends: R (>= 4.0.0)
Imports: dplyr,
  magick,
  pdftools,
  rJava,
  sf,
  stringr,
  tabulapdf (>= 0.2.2),
  tesseract,
  yaml
Encoding: UTF-8
